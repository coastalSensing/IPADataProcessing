    function stat(a){
      if(!a.length)return null;
      var s=a.slice().sort(function(x,y){return x-y;});
      var med=s[Math.floor(s.length/2)];
      var mean=a.reduce(function(x,y){return x+y;},0)/a.length;
      var sd=a.length>1?Math.sqrt(a.reduce(function(x,y){return x+(y-mean)*(y-mean);},0)/(a.length-1)):0;
      return {med:med,mean:mean,sd:sd,se:a.length>1?sd/Math.sqrt(a.length):0,n:a.length,min:s[0],max:s[s.length-1]};
