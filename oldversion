                      <input className="layback-input" type="number" value={wpThreshold} min={1} max={200} step={1}
                        onChange={function(e){setWpThreshold(parseFloat(e.target.value)||20);}}/>
                      <button className="layer-btn" style={{marginTop:4,color:'var(--neg)'}}
                        onClick={function(){setWaypoints([]);}}>Clear waypoints</button>
                    </div>
                  )}
                  <div style={{fontFamily:'var(--font-mono)',fontSize:8,color:'var(--dim)',marginTop:4,lineHeight:1.5}}>
