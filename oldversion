/* ── Map & run organizer additions ── */
.map-wrap{position:relative;background:#e8eef4;border-radius:3px;border:1px solid var(--border);overflow:hidden;}
.leaflet-container{border-radius:3px;height:100% !important;}
.map-controls-panel{background:rgba(255,255,255,.95);border:1px solid var(--border2);border-radius:3px;padding:8px 10px;font-family:var(--font-mono);font-size:10px;display:flex;flex-direction:column;gap:6px;}
.layer-btn-group{display:flex;gap:4px;flex-wrap:wrap;}
.layer-btn{padding:3px 8px;border-radius:2px;border:1px solid var(--border2);background:var(--panel);font-family:var(--font-mono);font-size:9px;cursor:pointer;color:var(--dim3);transition:all .15s;}
.layer-btn.active{background:var(--accent);color:#fff;border-color:var(--accent);}
.layer-btn:hover:not(.active){border-color:var(--accent);color:var(--accent);}
.file-sel-list{display:flex;flex-direction:column;gap:3px;max-height:140px;overflow-y:auto;}
.file-sel-row{display:flex;align-items:center;gap:6px;padding:2px 4px;border-radius:2px;cursor:pointer;}
.file-sel-row:hover{background:var(--panel2);}
.file-sel-check{width:12px;height:12px;accent-color:var(--accent);}
.layback-input{width:100%;background:var(--panel2);border:1px solid var(--border2);
  color:var(--text);font-family:var(--font-mono);font-size:11px;padding:4px 7px;
  border-radius:2px;box-sizing:border-box;}
