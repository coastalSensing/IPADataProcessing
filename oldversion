        if(r.verdict==='falsepos')summary.fp++;
        else if(r.verdict==='uncharted')summary.unch++;
        else if(r.verdict==='truepos')summary.tp++;
        out.push({date:dateStr,run:f.run,day:fday,site:r.nearest||'-',kind:'event',
