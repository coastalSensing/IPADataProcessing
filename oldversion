                  <option value="all">All field lines</option>
                  {runGroups.map(function(g){return <option key={g.id} value={g.id}>{g.name+' ('+g.fileIds.length+')'}</option>;})}
                </select>
                <button className="btn btn-sm" onClick={function(){stepTo(stepIdx-1);}}>&#8592; Prev</button>
                <button className="btn btn-sm" onClick={function(){stepTo(stepIdx+1);}}>Next &#8594;</button>
                <span style={{fontFamily:'var(--font-mono)',fontSize:12,color:'var(--accent)',fontWeight:'bold'}}>
