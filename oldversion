      var d0=f.packets[0].tms?new Date(f.packets[0].tms):null;
      var dateStr=d0?(d0.getFullYear()+'-'+String(d0.getMonth()+1).padStart(2,'0')+'-'+String(d0.getDate()).padStart(2,'0')):'';
      sites.forEach(function(s){
        if(dayFilter&&s.day&&fday&&s.day!==fday)return;
        var r=reviews[fk+'|'+s.id];
        if(!r||!r.verdict)return;
        if(r.verdict==='detected')summary.detected++;
        else if(r.verdict==='missed')summary.missed++;
        else summary.na++;
        if(r.classOk==='yes')summary.correct++;
        else if(r.classOk==='forced')summary.forced++;
        else if(r.classOk==='wrong'||r.classOk==='no')summary.wrong++;
        else if(r.classOk==='weak')summary.weak++;
        else if(r.classOk==='unsure')summary.unsure++;
        out.push({date:dateStr,run:f.run,day:fday,site:s.label,kind:'site',
                  verdict:r.verdict,classOk:r.classOk||'',cls:r.cls||'',
                  expected:r.expected||siteMaterials[s.label]||'',
                  closest:(r.closest!==undefined?r.closest:''),note:(r.note||'').replace(/[\r\n,]/g,' ')});
      });
