                  <input ref={wpFileRef} type="file" accept=".kml,.kmz" style={{display:'none'}}
                    onChange={function(e){loadWaypoints(e.target.files);}}/>
                  <button className="layer-btn" onClick={function(){wpFileRef.current&&wpFileRef.current.click();}}>
