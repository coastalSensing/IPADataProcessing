                  <button className="layer-btn" style={{width:'100%',marginTop:4}}
                    onClick={function(){autoGroupByDay();}}>Rebuild groups by day</button>
                  {(function(){
                    var g=runGroups.filter(function(x){return x.id===activeGroup;})[0];
                    if(!g)return null;
                    var ds={};
                    g.fileIds.forEach(function(i){
                      var f=files[i]; if(!f||!f.packets[0]||!f.packets[0].tms)return;
                      var d=new Date(f.packets[0].tms);
                      ds[d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')]=1;
