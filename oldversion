                  </div>
                </div>

                {/* File visibility selector */}
                {files.filter(function(f){return f.type==='field';}).length>0 && (
                  <div className="map-controls-panel" style={{flex:1}}>
                    <div style={{fontFamily:'var(--font-mono)',fontSize:9,textTransform:'uppercase',letterSpacing:'.08em',color:'var(--dim2)',marginBottom:4}}>
                      Files
                      <button onClick={function(){setVisibleFiles(null);}}
                        style={{marginLeft:6,background:'none',border:'none',color:'var(--accent)',cursor:'pointer',fontSize:9,fontFamily:'var(--font-mono)'}}>all</button>
                      <button onClick={function(){setVisibleFiles([]);}}
                        style={{marginLeft:4,background:'none',border:'none',color:'var(--dim)',cursor:'pointer',fontSize:9,fontFamily:'var(--font-mono)'}}>none</button>
                    </div>
