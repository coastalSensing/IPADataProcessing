                  </label>
                  <div style={{fontFamily:'var(--font-mono)',fontSize:9,color:'var(--dim2)',marginBottom:2,marginTop:4}}>Site cluster link (m)</div>
                  <input className="layback-input" type="number" value={siteLink} min={5} max={200} step={5}
                    onChange={function(e){setSiteLink(parseFloat(e.target.value)||10);}}/>
