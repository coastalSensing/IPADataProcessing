                    background:'var(--panel2)',padding:'4px 6px',borderRadius:2,textAlign:'center'}}>
                    {sites.length} sites · <b style={{color:'#d92b2b'}}>{covSummary.fail} fails</b> / {covSummary.pass} passes
                  </div>
                </div>

