                                })()}</td>
                                <td style={{fontSize:9,color:'var(--accent)'}}>{(function(){
                                  if(!ev.lat||!waypoints.length)return '';
                                  var corrLat=ev.lat,corrLon=ev.lon;
                                  if(useLayback){
                                    var _A=fileAnalyses[activeIdx];
                                    var corr=_A?laybackEventPos(af.pkts,ev.pktPeak,_A.trk):null;
                                    if(corr&&corr.lat!==null){corrLat=corr.lat;corrLon=corr.lon;}
                                  }
                                  var match=findNearestWaypoint(corrLat,corrLon,waypoints,wpThreshold);
                                  return match?match.wp.name+' ('+match.dist+'m)':'';
                                })()}</td>
                                <td style={{fontSize:9,color:'var(--dim2)'}}>{ar?'AI':'rules'}</td>
                                <td>{ld?<span className="spinner"/>:
                                  <button className="btn btn-ai btn-sm" style={{padding:'2px 7px',fontSize:9}}
                                    onClick={function(e){e.stopPropagation();doAI(activeIdx,ei);}}
                                    disabled={!apiKey||!!aiLoading}>AI</button>}</td>
                              </tr>
