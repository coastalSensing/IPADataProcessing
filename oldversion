                        </div>}
                        {lineStats.lb && <div style={{color:'var(--text)'}}>
                          layback <b>{lineStats.lb.med.toFixed(1)} m</b> &plusmn;{lineStats.lb.sd.toFixed(2)}
                        </div>}
                        {lineStats.ang && <div style={{color:'var(--dim2)'}}>
                          angle {lineStats.ang.med.toFixed(0)}&deg; ({lineStats.ang.min.toFixed(0)}&ndash;{lineStats.ang.max.toFixed(0)}&deg;)
