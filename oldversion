                        Hotspots ({clusters.length}{(function(){
                          var h=clusters.filter(function(g){return hiddenHotspots[hotspotKey(g)];}).length;
                          return h?', '+h+' hidden':'';
                        })()})
                        <button onClick={function(){setHiddenHotspots({});}}
                          style={{marginLeft:6,background:'none',border:'none',color:'var(--accent)',cursor:'pointer',fontSize:9,fontFamily:'var(--font-mono)'}}>show all</button>
                      </div>
                      <div className="file-sel-list">
                        {clusters.map(function(grp,hi){
                          var col=MAT_COLORS[grp[0].cls]||'#808080';
