      sites.forEach(function(s){
        if(dayFilter&&s.day&&fday&&s.day!==fday)return;
        var r=reviews[fk+'|'+s.id];
        if(!r||r.verdict!=='detected')return;
        // event: the anchored one if set, else nearest raw event to the site
        var ev=null;
        if(r.anchorCi!==undefined&&r.anchorCi!==null){
          ev=D.events.filter(function(e){return e.ci===r.anchorCi;})[0]||null;
        }
        if(!ev){
          var best=1e12;
          D.events.forEach(function(e){
            var d=distToSite(e.rawLat,e.rawLon,s);
            if(d<best){best=d;ev=e;}
          });
        }
        if(!ev||!ev.dpDev)return;
        var mat=r.expected||siteMaterials[s.label]||'Unknown';
        var devs=harms.map(function(h){return (ev.dpDev[h]!==undefined?ev.dpDev[h].toFixed(3):'');});
        rows.push([dateStr,f.run,s.label,mat,ev.cls,r.classOk||'',ev.nPkts,
                   (ev.snr||0).toFixed(2),(ev.snrInt||0).toFixed(2),
                   f.packets[0].xmt||4,harms.join('|')].concat(devs));
      });
    });
    if(!rows.length){alert('No Det-verdict sites reviewed yet - nothing to export.');return;}
    var hdr=['date','run','site','true_material','classifier_class','class_result','n_pkts',
             'peak_snr','int_snr','xmt_hz','harmonics','dev_h1','dev_h2','dev_h3','dev_h4','dev_h5','dev_h6'];
    var csv=hdr.join(',')+'\n'+rows.map(function(r){return r.join(',');}).join('\n');
    var b=new Blob([csv],{type:'text/csv'});
    var a=document.createElement('a');
    a.href=URL.createObjectURL(b); a.download='material_training_signatures.csv'; a.click();
  }

  function exportReport(){
    var rep=buildReport();
    if(!rep.rows.length){alert('No manual verdicts recorded yet.');return;}
    var hdr='date,run,day,site,kind,verdict,classification_result,reported_material,expected_material,closest_m,note\n';
    var body=rep.rows.map(function(r){
      return [r.date,r.run,r.day,r.site,r.kind,r.verdict,r.classOk,r.cls,r.expected||'',
              (typeof r.closest==='number'?r.closest.toFixed(1):r.closest),
              '"'+(r.note||'')+'"'].join(',');
    }).join('\n');
    var s=rep.summary;
    var foot='\n\n# summary,detected='+s.detected+',missed='+s.missed+',na='+s.na+
             ',class_correct='+s.correct+',class_forced='+s.forced+',class_wrong='+s.wrong+',class_weak='+s.weak+',class_unsure='+s.unsure+
             ',true_positives='+s.tp+',false_positives='+s.fp+',uncharted='+s.unch+'\n';
    var blob=new Blob([hdr+body+foot],{type:'text/csv'});
    var a=document.createElement('a');
    a.href=URL.createObjectURL(blob); a.download='northbeach_pass_fail_report.csv'; a.click();
  }

  var laybackDist=computeLayback(cableM,cableAngle,gpsOffset);

  // File loading
  var loadFiles=useCallback(function(fileList){
    var promises=[];
    for(var i=0;i<fileList.length;i++){
      promises.push((function(file){
        return file.text().then(function(text){
          var pkts=parseAnyFile(text);
          if(!pkts.length)return null;
          return{name:file.name,run:pkts[0].run||file.name,packets:pkts,
                 xmt:pkts[0].xmt,type:pkts[0].type};
        });
      })(fileList[i]));
    }
    Promise.all(promises).then(function(results){
      var newFiles=results.filter(function(r){return r!==null;});
      setFiles(function(prev){
        var seen={}; prev.forEach(function(f){seen[fileKey(f)]=1;});
        var add=newFiles.filter(function(f){
          var k=fileKey(f); if(seen[k])return false; seen[k]=1; return true;
        });
        var updated=prev.concat(add);
        if(!prev.length&&updated.length)setActiveIdx(0);
        // cache locally so a refresh does not mean re-uploading
        add.forEach(function(f){
          idbPut('files',{key:fileKey(f),name:f.name,run:f.run,xmt:f.xmt,type:f.type,packets:f.packets})
            .catch(function(e){console.warn('local cache write failed',e);});
        });
        return updated;
      });
    });
  },[]);

  // Restore the previous local session on mount
  var _usRS=useState('loading'),restoreState=_usRS[0],setRestoreState=_usRS[1];
  useEffect(function(){
    var restored=[];
    idbAll('files').then(function(recs){
      if(recs&&recs.length){
        var fs=recs.map(function(r){return {name:r.name,run:r.run,xmt:r.xmt,type:r.type,packets:r.packets};});
        fs.sort(function(a,b){
          var ta=a.packets[0]?a.packets[0].tms||0:0, tb=b.packets[0]?b.packets[0].tms||0:0;
          return ta-tb;
        });
        restored=fs;
        setFiles(fs); setActiveIdx(0);
      }
      return idbAll('meta');
    }).then(function(metas){
      var keyIdx={};
      restored.forEach(function(f,i){keyIdx[fileKey(f)]=i;});
      (metas||[]).forEach(function(m){
        if(m.key==='runGroups'&&m.value){
          var gs=m.value.map(function(g){
            var ids;
            if(g.fileKeys){
              ids=g.fileKeys.map(function(k){return keyIdx[k];})
                            .filter(function(i){return i!==undefined;});
            } else {
              ids=[];   // legacy index-based group: cannot be trusted, drop membership
            }
            return {id:g.id,name:g.name,color:g.color,fileIds:ids};
          }).filter(function(g){return g.fileIds.length;});
          setRunGroups(gs);
        }
        if(m.key==='waypoints'&&m.value) setWaypoints(m.value);
        if(m.key==='reviews'&&m.value) setReviews(m.value);
        if(m.key==='siteMaterials'&&m.value) setSiteMaterials(m.value);
        if(m.key==='settings'&&m.value){
          var s=m.value;
          if(s.cableM!==undefined)setCableM(s.cableM);
          if(s.cableAngle!==undefined)setCableAngle(s.cableAngle);
          if(s.gpsOffset!==undefined)setGpsOffset(s.gpsOffset);
          if(s.dragK!==undefined)setDragK(s.dragK);
          if(s.laybackMode!==undefined)setLaybackMode(s.laybackMode);
          if(s.detectRadius!==undefined)setDetectRadius(s.detectRadius);
          if(s.siteLink!==undefined)setSiteLink(s.siteLink);
          if(s.halfPkt!==undefined)setHalfPkt(s.halfPkt);
          if(s.dayFilter!==undefined)setDayFilter(s.dayFilter);
        }
      });
      setRestoreState('ready');
    }).catch(function(e){console.warn('local restore failed',e);setRestoreState('ready');});
  },[]);

  // AI classification
  var doAI=function(fi,ei){
    if(!apiKey){alert('Enter API key');return;}
    var f=files[fi];if(!f||f.type==='lab')return;
    var harms=getHarms(f.packets[0]?f.packets[0].xmt||4:4);
    var bg=computeBG(f.packets,harms);
    var clusters=detectAnomalies(f.packets,harms,bg);
    if(!clusters.length||!clusters[ei])return;
    var ev=classifyRules(clusters[ei],harms,bg);
    var key=fi+'-'+ei;
    setAiLoading(key);
    classifyWithClaude(ev,harms,bg,training,apiKey).then(function(r){
      setAiResults(function(prev){var next=Object.assign({},prev);next[key]=r;return next;});
      setSelEv(ei);
    }).catch(function(e){
      var err={classification:'Error',confidence_pct:0,confidence_label:'Error',
        key_indicators:'',reasoning:e.message,caution:null};
      setAiResults(function(prev){var next=Object.assign({},prev);next[key]=err;return next;});
    }).finally(function(){setAiLoading(null);});
  };

  var doAIAll=function(){
    if(!analysis||analysis.isLab||!apiKey)return;
    var i=0;
    function next(){
      if(i>=analysis.events.length)return;
      var ei=i++;
      var f=files[activeIdx];
      var harms=getHarms(f.packets[0].xmt||4);
      var bg=computeBG(f.packets,harms);
      var clusters=detectAnomalies(f.packets,harms,bg);
      if(!clusters[ei]){next();return;}
      var ev=classifyRules(clusters[ei],harms,bg);
      var key=activeIdx+'-'+ei;
      setAiLoading(key);
      classifyWithClaude(ev,harms,bg,training,apiKey).then(function(r){
        setAiResults(function(prev){var nx=Object.assign({},prev);nx[key]=r;return nx;});
        setSelEv(ei);
      }).catch(function(e){
        var err={classification:'Error',confidence_pct:0,confidence_label:'Error',
          key_indicators:'',reasoning:e.message,caution:null};
        setAiResults(function(prev){var nx=Object.assign({},prev);nx[key]=err;return nx;});
      }).finally(function(){
        setAiLoading(null);
        setTimeout(next,600);
      });
    }
    next();
  };

  var saveTraining=function(fi,ei){
    if(!confMat)return;
    var f=files[fi];if(!f||f.type==='lab')return;
    var harms=getHarms(f.packets[0]?f.packets[0].xmt||4:4);
    var bg=computeBG(f.packets,harms);
    var clusters=detectAnomalies(f.packets,harms,bg);
    if(!clusters.length||!clusters[ei])return;
    var ev=classifyRules(clusters[ei],harms,bg);
    var aiRes=aiResults[fi+'-'+ei];
    var entry={
      material:confMat,run:f.run,ts:ev.ts,
      fv:{dp1:ev.dp[harms[0]]||0,dp3:ev.dp[harms[2]]||0,dp_last:ev.dp[harms[5]]||0,
          magPct:ev.magPct,maxSNR:ev.maxSNR},
      aiConf:aiRes?aiRes.confidence_pct:ev.confPct
    };
    // Optimistic local update immediately
    setTraining(function(prev){return prev.concat([entry]);});
    setConfMat('');
    // Persist to Supabase in background
    setDbStatus('loading');
    saveTrainingToDB(entry,harms)
      .then(function(rows){
        // Update local entry with DB-assigned id so we can delete it later
        if(rows&&rows[0]){
          var dbId=rows[0].id;
          setTraining(function(prev){
            var updated=prev.slice();
            updated[updated.length-1]=Object.assign({},updated[updated.length-1],{id:dbId});
            return updated;
          });
        }
        setDbStatus('ok');
      })
      .catch(function(e){
        console.warn('Supabase save failed:',e.message);
        setDbStatus('error');
      });
  };

