                    <label style={{display:'flex',alignItems:'center',gap:4,fontFamily:'var(--font-mono)',fontSize:9,color:'var(--dim2)',marginTop:5}}>
                      <input type="checkbox" checked={halfPkt} onChange={function(e){setHalfPkt(e.target.checked);}}/>
                      half-packet bias
                    </label>
                  </div>)}
                  <div style={{fontFamily:'var(--font-mono)',fontSize:10,color:'var(--accent)',marginTop:6,
                    background:'var(--panel2)',padding:'4px 6px',borderRadius:2,textAlign:'center'}}>
                    {laybackMode==='fixed'
