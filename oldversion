// Stable identity for a file across reloads: run designation + first packet time
function fileKey(f){
  var t=(f.packets&&f.packets.length)?(f.packets[0].tms||f.packets[0].ts||''):'';
  return (f.run||'?')+'|'+t;
}


// ── Reverse solve: infer layback from a user-anchored detection/target pair ───
// Both quantities are measured on the RAW GPS track, so the result is independent
// of whatever layback is currently configured.
//   impliedLayback = alongTrack(detection packet) - alongTrack(closest approach to site)
// A trailing sensor can only give a POSITIVE value: the boat passes the target first,
// the sensor reaches it later. Negative means the pairing is wrong.
function rawCumulative(packets){
  var cum=new Array(packets.length), acc=0, last=null;
  for(var i=0;i<packets.length;i++){
    var pk=packets[i];
    if(pk.lat===null||pk.lon===null){ cum[i]=acc; continue; }
    if(last) acc+=haversineM(last.lat,last.lon,pk.lat,pk.lon);
    cum[i]=acc; last=pk;
  }
  return cum;
}

// Invert the drag model for one anchor: given the implied layback and the speed at
// that moment, what k reproduces it?  L = gps + cable*cos(theta) - v*dt/2
function solveKFromLayback(L, v, dt, cableM, gpsOffset, halfPkt){
  var eff = L - gpsOffset + (halfPkt&&v&&dt ? v*dt/2 : 0);
  var c = eff/cableM;
  if(c>=1) return {k:null,angle:0,note:'cable too short for this offset'};
  if(c<=0) return {k:null,angle:90,note:'offset at or behind the antenna'};
  var th=Math.acos(c);
  return {k:Math.tan(th)*v*v, angle:th*180/Math.PI, note:null};
}

function median(a){
  if(!a.length) return null;
  var s=a.slice().sort(function(x,y){return x-y;});
  var m=Math.floor(s.length/2);
  return s.length%2?s[m]:(s[m-1]+s[m])/2;
}
function meanSd(a){
  if(!a.length) return null;
  var m=a.reduce(function(x,y){return x+y;},0)/a.length;
  var sd=a.length>1?Math.sqrt(a.reduce(function(x,y){return x+(y-m)*(y-m);},0)/(a.length-1)):0;
  return {mean:m,sd:sd,se:a.length>1?sd/Math.sqrt(a.length):0,n:a.length};
}

