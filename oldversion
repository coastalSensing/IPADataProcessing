                  </div>
                  <div style={{fontFamily:'var(--font-mono)',fontSize:8,color:'var(--dim)',marginTop:4,lineHeight:1.5}}>
                    From drawing: GPS 4.12m fwd of tie-down, 31m cable at 25° typical angle.
                  </div>
                </div>

                {/* Waypoint loader */}
                <div className="map-controls-panel">
                  <div style={{fontFamily:'var(--font-mono)',fontSize:9,textTransform:'uppercase',letterSpacing:'.08em',color:'var(--dim2)',marginBottom:4}}>
