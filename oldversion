  }
  ctx.fillStyle='#6080a0';ctx.font='9px monospace';ctx.textAlign='center';
  for(var hi=0;hi<harms.length;hi++)ctx.fillText(harms[hi]+'Hz',xS(hi),H-2);
  var pts=[];
  for(var hi=0;hi<harms.length;hi++){
    pts.push({x:xS(hi),y:yS(Math.min(Math.max(dpMap[harms[hi]]||0,yr[0]),yr[1]))});
  }
  var zero=yS(Math.max(yr[0],0));
  ctx.fillStyle=color+'22';
  ctx.beginPath();ctx.moveTo(pts[0].x,zero);
  for(var pi=0;pi<pts.length;pi++)ctx.lineTo(pts[pi].x,pts[pi].y);
  ctx.lineTo(pts[pts.length-1].x,zero);ctx.closePath();ctx.fill();
  ctx.strokeStyle=color;ctx.lineWidth=2;
  ctx.beginPath();
  for(var pi=0;pi<pts.length;pi++){if(pi)ctx.lineTo(pts[pi].x,pts[pi].y);else ctx.moveTo(pts[pi].x,pts[pi].y);}
  ctx.stroke();
  ctx.fillStyle=color;
  for(var pi=0;pi<pts.length;pi++){ctx.beginPath();ctx.arc(pts[pi].x,pts[pi].y,4,0,Math.PI*2);ctx.fill();}
  ctx.strokeStyle='#dde4ed';ctx.lineWidth=1;ctx.strokeRect(PL,PT,cW,cH);
}

// ── Map drawing ────────────────────────────────────────────────────────────────

// ── Leaflet map helpers ────────────────────────────────────────────────────────
// Cluster hotspots that are within ~20m of each other across files
// clusterHotspots: groups hotspots within thresholdM metres of each other.
// Default 25m (raw GPS), use 15m when layback-corrected positions are supplied.
// Stable key for a hotspot cluster: which detections it contains, not where it
// happens to sit in the array. Array indices shift whenever the visible files or
// layback settings change, which silently hides unrelated hotspots.
function hotspotKey(grp){
  return grp.map(function(g){return g.fi+':'+g.ci;}).sort().join(',');
}

function clusterHotspots(hotspots,thresholdM){
  var tm=thresholdM||25;
  // Convert threshold metres to approx degrees (at ~47.7°N)
  var THRESH_LAT=tm/111000;
  var THRESH_LON=tm/(111000*Math.cos(47.7*Math.PI/180));
  var clusters=[],used={};
  for(var i=0;i<hotspots.length;i++){
    if(used[i])continue;
    var grp=[hotspots[i]];used[i]=true;
    for(var j=i+1;j<hotspots.length;j++){
      if(used[j])continue;
      if(Math.abs(hotspots[i].lat-hotspots[j].lat)<THRESH_LAT&&
         Math.abs(hotspots[i].lon-hotspots[j].lon)<THRESH_LON){
        grp.push(hotspots[j]);used[j]=true;
      }
    }
    clusters.push(grp);
  }
  return clusters;
}

// buildHotspots: computes anomaly positions with optional layback correction.
// Layback correction is applied PER PACKET using instantaneous bearing so that
// detections of the same physical target from different survey directions
// converge to the same corrected position and cluster correctly.
function buildHotspots(files,aiResults,visibleFileIds,doLayback,laybackM,analyses){
  var hotspots=[];
  for(var fi=0;fi<files.length;fi++){
    if(visibleFileIds&&visibleFileIds.indexOf(fi)<0)continue;
    var f=files[fi];
    if(f.type!=='field'||!f.packets.length)continue;
    var A=analyses&&analyses[fi];
    if(!A)continue;
    var harms=A.harms, bg=A.bg, clusters=A.clusters;
    var trkIdx={};
    f.packets.forEach(function(p,i){trkIdx[p.idx]=i;});
    for(var ci=0;ci<clusters.length;ci++){
      var ev=classifyRules(clusters[ci],harms,bg);
      var aiKey=fi+'-'+ci;
      var aiRes=aiResults[aiKey];
      var cls=aiRes?aiRes.classification:ev.cls;
      // Use packets with valid GPS
      var pktsWithGPS=clusters[ci].map(function(a){return a.pk;})
        .filter(function(pk){return pk.lat!==null&&pk.lon!==null;});
      if(!pktsWithGPS.length)continue;
      var clat=0,clon=0;
      for(var pi=0;pi<pktsWithGPS.length;pi++){
        var pk=pktsWithGPS[pi];
        if(doLayback){
          // Path-following corrected position, precomputed for the whole file
          var ti=trkIdx[pk.idx];
          var corr=(ti!==undefined&&A.trk[ti]&&A.trk[ti].lat!==null)?A.trk[ti]:{lat:pk.lat,lon:pk.lon};
          clat+=corr.lat;clon+=corr.lon;
        } else {
          clat+=pk.lat;clon+=pk.lon;
        }
      }
      clat/=pktsWithGPS.length;
      clon/=pktsWithGPS.length;
      hotspots.push({lat:clat,lon:clon,cls:cls,conf:ev.confPct,
        fi:fi,ci:ci,run:f.run,nPkts:ev.nPkts,laybackApplied:!!(doLayback&&laybackM>0)});
    }
  }
  // Cluster threshold: when layback is applied, same-target detections from
  // different runs should converge to within ~5-10m. Use 15m threshold.
  // Without layback, use wider 25m threshold to loosely group nearby raw GPS positions.
  return clusterHotspots(hotspots, doLayback?15:25);
}

// ── Layback correction ────────────────────────────────────────────────────────
// From survey 202604 drawing:
//   GPS is 4.12m FORWARD of cable tie-down at transom
//   Cable deployed to 31m mark from tie-down
//   Sensor position = GPS position offset BACKWARD along track by layback distance
//
// laybackM = gpsOffsetM + cableM * cos(cableAngleDeg * PI/180)
// bearing  = direction of travel computed from recent GPS track history
// corrected position = GPS - layback along bearing

function computeLayback(cableM, angleDeg, gpsOffsetM){
  var horiz = cableM * Math.cos(angleDeg * Math.PI / 180);
  return gpsOffsetM + horiz;  // total metres from GPS to sensor
}

// Move a lat/lon point backward along a bearing by distanceM metres
function applyLayback(lat, lon, bearingDeg, distanceM){
  var R = 6371000;  // Earth radius metres
  var bearingRad = (bearingDeg + 180) * Math.PI / 180;  // reverse: sensor is BEHIND
  var dLat = (distanceM / R) * Math.cos(bearingRad);
  var dLon = (distanceM / R) * Math.sin(bearingRad) / Math.cos(lat * Math.PI / 180);
  return {
    lat: lat + dLat * 180 / Math.PI,
    lon: lon + dLon * 180 / Math.PI
  };
}

// Compute instantaneous bearing from a packet array at index i
// Uses a window of prev N packets to smooth the heading
function computeBearing(packets, i){
  var N = Math.min(5, i);
  if(N < 1) return 0;
  var p0 = packets[i - N], p1 = packets[i];
  if(!p0 || !p1 || p0.lat===null || p1.lat===null) return 0;
  var dLat = p1.lat - p0.lat;
  var dLon = (p1.lon - p0.lon) * Math.cos(p0.lat * Math.PI / 180);
  return Math.atan2(dLon, dLat) * 180 / Math.PI;
}

// Apply layback correction to all packets in a file
// Returns new array of {lat, lon, idx, ts} with corrected positions
function applyLaybackToFile(packets, laybackM){
  var result = [];
  for(var i = 0; i < packets.length; i++){
    var pk = packets[i];
    if(pk.lat === null || pk.lon === null){
      result.push({lat:null, lon:null, idx:pk.idx, ts:pk.ts});
      continue;
    }
    var bearing = computeBearing(packets, i);
    var corrected = applyLayback(pk.lat, pk.lon, bearing, laybackM);
    result.push({lat:corrected.lat, lon:corrected.lon, idx:pk.idx, ts:pk.ts});
  }
  return result;
}

// ── KMZ / KML waypoint parser ─────────────────────────────────────────────────
// Parses KML text and returns array of {name, lat, lon}
function parseKML(text){
  var parser = new DOMParser();
  var doc = parser.parseFromString(text, 'text/xml');
  var placemarks = doc.querySelectorAll('Placemark');
  var waypoints = [];
  placemarks.forEach(function(pm){
    var nameEl = pm.querySelector('name') || pm.querySelector('n');
    var coordEl = pm.querySelector('coordinates') || pm.querySelector('Point coordinates');
    if(!nameEl || !coordEl) return;
    var name = nameEl.textContent.trim();
    var coords = coordEl.textContent.trim().split(',');
    if(coords.length < 2) return;
    var lon = parseFloat(coords[0]);
    var lat = parseFloat(coords[1]);
    if(!isNaN(lat) && !isNaN(lon)){
      waypoints.push({name:name, lat:lat, lon:lon});
    }
  });
  return waypoints;
}

// Parse KMZ (zip containing doc.kml)
async function parseKMZ(file){
  // KMZ is a ZIP containing a .kml (usually doc.kml). Fall back to plain KML text.
  var head = await file.slice(0,64).text();
  if(head.trim().startsWith('<?xml') || head.trim().startsWith('<kml')){
    return parseKML(await file.text());
  }
  if(typeof JSZip === 'undefined'){
    alert('JSZip failed to load - cannot open KMZ. Check network access to cdnjs.');
    return [];
  }
  var zip = await JSZip.loadAsync(await file.arrayBuffer());
  var kmlName = Object.keys(zip.files).filter(function(n){
    return /\.kml$/i.test(n) && !zip.files[n].dir;
  }).sort(function(a,b){
    // prefer doc.kml, then shallowest path
    if(/doc\.kml$/i.test(a) !== /doc\.kml$/i.test(b)) return /doc\.kml$/i.test(a) ? -1 : 1;
    return a.split('/').length - b.split('/').length;
  })[0];
  if(!kmlName) return [];
  return parseKML(await zip.files[kmlName].async('string'));
}

// Find nearest waypoint to a corrected event position
function findNearestWaypoint(lat, lon, waypoints, thresholdM){
  var best = null, bestDist = Infinity;
  for(var i = 0; i < waypoints.length; i++){
    var wp = waypoints[i];
    var dLat = (lat - wp.lat) * 111000;
    var dLon = (lon - wp.lon) * 111000 * Math.cos(lat * Math.PI / 180);
    var dist = Math.sqrt(dLat*dLat + dLon*dLon);
    if(dist < bestDist){ bestDist = dist; best = wp; }
  }
  if(best && bestDist <= thresholdM) return {wp:best, dist:Math.round(bestDist)};
  return null;
}


// ── Speed / dynamic layback ───────────────────────────────────────────────────
// Speed is derived from the GPS fixes and packet timestamps in the file itself.
// Cable angle from horizontal is modelled as tan(theta) = k / v^2 : net weight of
// the cable+sensor balanced against hydrodynamic drag, which scales as v^2. k is a
// single lumped constant (m^2/s^2) and is the ONLY free parameter. Its default
// reproduces 25 deg at 1.5 m/s, matching the previous fixed-angle default; it must
// be calibrated against known targets before the numbers mean anything.
var DRAG_K_DEFAULT = Math.tan(25*Math.PI/180) * 1.5 * 1.5;   // = 1.049

function haversineM(la1,lo1,la2,lo2){
  var R=6371000, dLat=(la2-la1)*Math.PI/180, dLon=(lo2-lo1)*Math.PI/180;
  var la=(la1+la2)/2*Math.PI/180;
  var x=dLon*Math.cos(la), y=dLat;
  return Math.sqrt(x*x+y*y)*R;
}

// Per-packet speed (m/s) smoothed over a distance-based window, plus packet interval (s)
function packetKinematics(packets, winM){
  winM = winM || 12;
  var n=packets.length, spd=new Array(n), dts=new Array(n);
  for(var i=0;i<n;i++){ spd[i]=null; dts[i]=null; }
  for(var i=0;i<n;i++){
    var pk=packets[i];
    if(pk.lat===null||pk.lon===null) continue;
    // walk back until winM of track accumulated
    var j=i, acc=0;
    while(j>0){
      var a=packets[j], b=packets[j-1];
      if(b.lat===null||b.lon===null) break;
      acc+=haversineM(b.lat,b.lon,a.lat,a.lon);
      j--;
      if(acc>=winM) break;
    }
    var dt=(pk.tms&&packets[j].tms)?(pk.tms-packets[j].tms)/1000:null;
    if(dt&&dt>0&&acc>0) spd[i]=acc/dt;
    // instantaneous packet interval
    if(i>0&&pk.tms&&packets[i-1].tms) dts[i]=(pk.tms-packets[i-1].tms)/1000;
  }
  // fill gaps with nearest valid
  var lastS=null;
  for(var i=0;i<n;i++){ if(spd[i]!==null) lastS=spd[i]; else spd[i]=lastS; }
  for(var i=n-1;i>=0;i--){ if(spd[i]===null&&i<n-1) spd[i]=spd[i+1]; }
  var dv=dts.filter(function(x){return x!==null&&x>0;}).sort(function(a,b){return a-b;});
  var medDt=dv.length?dv[Math.floor(dv.length/2)]:null;
  for(var i=0;i<n;i++){ if(dts[i]===null||dts[i]<=0) dts[i]=medDt; }
  return {speed:spd, dt:dts, medDt:medDt};
}

function cableAngleDeg(v, k){
  if(!v||v<=0.05) return 89;
  return Math.atan(k/(v*v))*180/Math.PI;
}

// Total along-track offset from GPS antenna to effective measurement position.
// gpsOffset : GPS antenna forward of the cable tie-down (4.12 m from the survey drawing)
// cableM    : deployed cable length to the sensor (31 m mark)
// halfPkt   : position is stamped at packet START but the measurement integrates over
//             the packet, so the effective centroid is v*dt/2 further along track.
function laybackAt(v, dt, cableM, k, gpsOffset, halfPkt){
  var th=cableAngleDeg(v,k);
  var L=gpsOffset + cableM*Math.cos(th*Math.PI/180);
  if(halfPkt && v && dt) L -= v*dt/2;
  return {layback:L, angle:th};
}

// Layback a whole file. mode 'fixed' uses a constant angle, 'speed' uses the drag model.
//
// The sensor is NOT projected sideways along an instantaneous heading. A towed body
// follows the boat's path, so the sensor sits where the boat was when it had travelled
// `layback` metres less along the recorded track. Projecting along a bearing instead
// multiplies GPS heading jitter by the ~32 m lever arm and knots up the corrected line:
// measured track roughness goes from 0.40 m (raw) to 1.18 m mean / 14.9 m max, while
// path-following stays at 0.47 m mean / 2.6 m max.
function laybackTrack(packets, P){
  var kin = P.mode==='speed' ? packetKinematics(packets) : null;
  var n=packets.length;
  // cumulative along-track distance over valid fixes
  var cum=new Array(n), last=null, acc=0;
  for(var i=0;i<n;i++){
    var pk=packets[i];
    if(pk.lat===null||pk.lon===null){ cum[i]=acc; continue; }
    if(last!==null) acc+=haversineM(last.lat,last.lon,pk.lat,pk.lon);
    cum[i]=acc; last=pk;
  }
  function backAlongPath(i,dist){
    var target=cum[i]-dist;
    if(target<=cum[0]) return null;           // sensor was not yet in the recorded track
    var j=i;
    while(j>0 && cum[j]>target) j--;
    var a=packets[j], b=packets[Math.min(j+1,n-1)];
    if(!a||a.lat===null) return null;
    if(!b||b.lat===null) return {lat:a.lat,lon:a.lon};
    var seg=cum[Math.min(j+1,n-1)]-cum[j];
    var t=seg>0?(target-cum[j])/seg:0;
    return {lat:a.lat+t*(b.lat-a.lat), lon:a.lon+t*(b.lon-a.lon)};
  }
  var out=[];
  for(var i=0;i<n;i++){
    var pk=packets[i];
    if(pk.lat===null||pk.lon===null){ out.push({lat:null,lon:null,idx:pk.idx,ts:pk.ts,lb:null,spd:null,ang:null}); continue; }
    var lb, ang, v=null, dt=null;
    if(P.mode==='speed'){
      v=kin.speed[i]; dt=kin.dt[i];
      var r=laybackAt(v,dt,P.cableM,P.k,P.gpsOffset,P.halfPkt);
      lb=r.layback; ang=r.angle;
    } else {
      ang=P.angleDeg;
      lb=P.gpsOffset + P.cableM*Math.cos(ang*Math.PI/180);
    }
    var c=backAlongPath(i,lb);
    var b=computeBearing(packets,i);
    if(!c) c=applyLayback(pk.lat,pk.lon,b,lb);   // start of line: no path behind us yet
    out.push({lat:c.lat,lon:c.lon,idx:pk.idx,ts:pk.ts,lb:lb,spd:v,ang:ang,brg:b,onPath:true});
  }
  return out;
}

// Corrected position of a single event from an ALREADY COMPUTED track.
// Never rebuild the track per event - that is O(events x packets) and locks the UI.
function laybackEventPos(packets, pktPeak, trk){
  if(!trk) return null;
  for(var i=0;i<packets.length;i++){
    if(packets[i].idx===pktPeak) return trk[i];
  }
  return null;
}

// ── Target sites: cluster waypoints into physical targets ─────────────────────
// Single-link clustering. Waypoints within linkM of each other belong to one site.
// Each site is reduced to a segment (its two most distant members) so that a pass is
// judged against the whole target, not just its centre.
// Survey-day code from a waypoint name: 1A-3 -> 1, 2C-6 -> 2, 3B-1 -> 3, plain
// numeric GPS marks default to 3. A site then takes the MAJORITY day of its members,
// which correctly pulls stray numeric marks into the named site they sit on.
function waypointDayCode(name){
  var m=/^([123])[A-Za-z]/.exec(name);
  if(m) return parseInt(m[1],10);
  if(/^[0-9]+$/.test(name)) return 3;
  return 0;
}

function buildSites(waypoints, linkM){
  linkM = linkM || 10;
  var n=waypoints.length; if(!n) return [];
  var parent=[]; for(var i=0;i<n;i++) parent.push(i);
  function find(a){ while(parent[a]!==a){ parent[a]=parent[parent[a]]; a=parent[a]; } return a; }
  for(var i=0;i<n;i++) for(var j=i+1;j<n;j++){
    if(haversineM(waypoints[i].lat,waypoints[i].lon,waypoints[j].lat,waypoints[j].lon)<=linkM){
      var ra=find(i), rb=find(j); if(ra!==rb) parent[rb]=ra;
    }
  }
  var groups={};
  for(var i=0;i<n;i++){ var r=find(i); (groups[r]=groups[r]||[]).push(waypoints[i]); }
  var sites=[];
  Object.keys(groups).forEach(function(key){
    var g=groups[key];
    var clat=g.reduce(function(a,w){return a+w.lat;},0)/g.length;
    var clon=g.reduce(function(a,w){return a+w.lon;},0)/g.length;
    // endpoints = most distant pair
    var A=g[0],B=g[0],best=-1;
    for(var i=0;i<g.length;i++) for(var j=i+1;j<g.length;j++){
      var d=haversineM(g[i].lat,g[i].lon,g[j].lat,g[j].lon);
      if(d>best){best=d;A=g[i];B=g[j];}
    }
    var names=g.map(function(w){return w.name;});
    // label: shared alpha prefix if present, else numeric range
    var alpha=names.filter(function(s){return /^[0-9]+[A-Za-z]/.test(s);});
    var label;
    if(alpha.length) label=alpha[0].match(/^[0-9]+[A-Za-z]/)[0];
    else { var nums=names.map(Number).filter(function(x){return !isNaN(x);}).sort(function(a,b){return a-b;});
           label = nums.length ? (nums[0]+'-'+nums[nums.length-1]) : names[0]; }
    var votes={};
    names.forEach(function(nm2){var d=waypointDayCode(nm2); votes[d]=(votes[d]||0)+1;});
    var day=0,bestv=-1;
    Object.keys(votes).forEach(function(d){ if(votes[d]>bestv){bestv=votes[d];day=parseInt(d,10);} });
    sites.push({id:'S'+sites.length, label:label, members:names, n:g.length, day:day,
                lat:clat, lon:clon, aLat:A.lat, aLon:A.lon, bLat:B.lat, bLon:B.lon,
                len:best, halfLen:best/2});
  });
  sites.sort(function(a,b){return b.lat-a.lat;});
  return sites;
}

// Distance from a point to a site's segment, in metres (local flat approximation)
function distToSite(lat, lon, s){
  var mlat=(s.aLat+s.bLat)/2, cs=Math.cos(mlat*Math.PI/180);
  function X(lo){return lo*111320*cs;} function Y(la){return la*110540;}
  var px=X(lon),py=Y(lat), ax=X(s.aLon),ay=Y(s.aLat), bx=X(s.bLon),by=Y(s.bLat);
  var vx=bx-ax, vy=by-ay, L2=vx*vx+vy*vy;
  if(L2===0) return Math.sqrt((px-ax)*(px-ax)+(py-ay)*(py-ay));
  var t=Math.max(0,Math.min(1,((px-ax)*vx+(py-ay)*vy)/L2));
  var qx=ax+t*vx, qy=ay+t*vy;
  return Math.sqrt((px-qx)*(px-qx)+(py-qy)*(py-qy));
}

// ── Coverage evaluation: did this line pass a site, and did it see it? ─────────
// PASS  : corrected sensor track came within radiusM of the site segment
// HIT   : a detected event's corrected position is also within radiusM of that site
// FAIL  : passed within radiusM but no event within radiusM  <-- the number that matters
// A file participates in the survey-day ranking only if its track passes near the
// loaded waypoint field. Without this, loading a second dataset from another location
// shifts the date ranks: its dates steal day-codes 1..3, every local line stops
// matching its sites (empty review table, no anchoring), and the foreign lines start
// matching sites hundreds of km away. Samples ~9 packets; 2 km radius.
function fileNearsSites(f,sites,maxM){
  if(!sites||!sites.length) return true;      // no waypoints loaded: rank everything
  var pks=f.packets, n=pks.length;
  if(!n) return false;
  var step=Math.max(1,Math.floor(n/8));
  for(var i=0;i<n;i+=step){
    var p=pks[i];
    if(p.lat===null||p.lon===null) continue;
    for(var s=0;s<sites.length;s++){
      if(haversineM(p.lat,p.lon,sites[s].lat,sites[s].lon)<=(maxM||2000)) return true;
    }
  }
  return false;
}

function evaluateCoverage(files, sites, P, radiusM, aiResults, dayFilter, analyses){
  var rows=[];
  // Map survey-day code (1,2,3) onto the actual dates present in the loaded files,
  // so a day-1 line is never scored against a target that was not deployed until day 3.
  var dates=[], nearCache={};
  files.forEach(function(f,fi){
    if(f.type!=='field'||!f.packets||!f.packets.length) return;
    nearCache[fi]=fileNearsSites(f,sites,2000);
    if(!nearCache[fi]) return;                 // foreign-survey files don't take day slots
    var t=f.packets[0].tms; if(!t) return;
    var d=new Date(t); var key=d.getFullYear()*10000+(d.getMonth()+1)*100+d.getDate();
    if(dates.indexOf(key)<0) dates.push(key);
  });
  dates.sort(function(a,b){return a-b;});
  function fileDayCode(f,fi){
    if(fi!==undefined&&nearCache[fi]===false) return 0;
    var t=f.packets[0].tms; if(!t) return 0;
    var d=new Date(t); var key=d.getFullYear()*10000+(d.getMonth()+1)*100+d.getDate();
    return dates.indexOf(key)+1;
  }
  for(var fi=0; fi<files.length; fi++){
    var f=files[fi];
    if(f.type!=='field'||!f.packets||!f.packets.length) continue;
    var fDay=fileDayCode(f,fi);
    var A=analyses&&analyses[fi];
    if(!A) continue;
    var trk=A.trk;
    var valid=trk.filter(function(p){return p.lat!==null;});
    if(valid.length<2) continue;
    // heading straight from the file: first -> last valid fix
    var h0=valid[0], h1=valid[valid.length-1];
    var dy=(h1.lat-h0.lat), dx=(h1.lon-h0.lon)*Math.cos(h0.lat*Math.PI/180);
    var hdg=(Math.atan2(dx,dy)*180/Math.PI+360)%360;
    var dirTxt = (hdg>90&&hdg<270) ? 'S' : 'N';
    // event positions, layback-corrected (precomputed)
    var evs=A.events.map(function(e){
      var aiKey=fi+'-'+e.ci;
      return {lat:e.lat,lon:e.lon,ci:e.ci,snr:e.snr,
              cls:(aiResults&&aiResults[aiKey]&&aiResults[aiKey].material)||e.cls};
    });
    // speed summary (from the precomputed track)
    var sp=trk.map(function(p){return p.spd;}).filter(function(x){return x!==null&&x!==undefined;}).sort(function(a,b){return a-b;});
    var medSpd=sp.length?sp[Math.floor(sp.length/2)]:null;
    var medLb=null, medAng=null;
    var lbs=trk.map(function(p){return p.lb;}).filter(function(x){return x!==null;}).sort(function(a,b){return a-b;});
    if(lbs.length) medLb=lbs[Math.floor(lbs.length/2)];
    var angs=trk.map(function(p){return p.ang;}).filter(function(x){return x!==null;}).sort(function(a,b){return a-b;});
    if(angs.length) medAng=angs[Math.floor(angs.length/2)];
    var matched={};
    sites.forEach(function(s){
      if(dayFilter && s.day && fDay && s.day!==fDay) return;
      var dmin=Infinity, kmin=-1;
      for(var i=0;i<trk.length;i++){
        if(trk[i].lat===null) continue;
        var d=distToSite(trk[i].lat,trk[i].lon,s);
        if(d<dmin){dmin=d;kmin=i;}
      }
      if(dmin>radiusM) return;   // not a pass, no verdict
      var hit=null, hd=Infinity;
      evs.forEach(function(e){
        var d=distToSite(e.lat,e.lon,s);
        if(d<=radiusM && d<hd){hd=d;hit=e;}
      });
      if(hit) matched[hit.ci]=true;
      rows.push({fi:fi, run:f.run, dir:dirTxt, hdg:hdg, site:s.label, siteId:s.id,
                 closest:dmin, status:hit?'HIT':'FAIL',
                 cls:hit?hit.cls:'', evDist:hit?hd:null, snr:hit?hit.snr:null,
                 spd:medSpd, layback:medLb, angle:medAng,
                 tIdx:kmin});
    });
    // events not matched to any site = unattributed
    evs.forEach(function(e){
      if(matched[e.ci]) return;
      var nearest=null,nd=Infinity;
      sites.forEach(function(s){var d=distToSite(e.lat,e.lon,s); if(d<nd){nd=d;nearest=s;}});
      rows.push({fi:fi, run:f.run, dir:dirTxt, hdg:hdg, site:nearest?nearest.label:'-', siteId:nearest?nearest.id:'',
                 closest:nd, status:'UNATTRIB', cls:e.cls, evDist:nd, snr:e.snr,
                 spd:medSpd, layback:medLb, angle:medAng, tIdx:null});
    });
  }
  return rows;
}


// ── Local session store (IndexedDB) ───────────────────────────────────────────
// Everything stays on this machine. Nothing here touches Supabase or the network.
// Parsed files, run groups, waypoints, manual reviews and settings survive a refresh.
var IDB_NAME='ipa_mip_local', IDB_VER=1;
function idbOpen(){
  return new Promise(function(res,rej){
    var rq=indexedDB.open(IDB_NAME,IDB_VER);
