                  <div style={{fontFamily:'var(--font-mono)',fontSize:9,color:'var(--dim2)',marginBottom:2,marginTop:4}}>Cable angle (°)</div>
                  <input className="layback-input" type="number" value={cableAngle} min={0} max={60} step={1}
